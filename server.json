{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.louisperner/astro-checker",
  "title": "AstroMCP",
  "description": "Read-only access to public astronomy archives: TNS, SIMBAD, VSX, Gaia, TESS, ZTF, Rubin, SkyBoT.",
  "repository": {
    "url": "https://github.com/louisperner/AstroMCP",
    "source": "github"
  },
  "websiteUrl": "https://github.com/louisperner/AstroMCP",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "astro-checker",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TNS_BOT_ID",
          "description": "Transient Name Server bot ID (optional; enables live TNS queries)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "TNS_BOT_NAME",
          "description": "Transient Name Server bot name (optional)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "TNS_API_KEY",
          "description": "Transient Name Server bot API key (optional)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "ASTROMCP_CACHE_DIR",
          "description": "Disk cache directory (default ~/.cache/astromcp)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
