# All optional. Copy into your MCP client's "env" block (AstroMCP does not read .env files itself).

# Transient Name Server bot credentials (https://www.wis-tns.org/bots) for live TNS queries
TNS_BOT_ID=
TNS_BOT_NAME=
TNS_API_KEY=

# Use a downloaded tns_public_objects.csv.zip when there are no credentials
TNS_PUBLIC_CSV=

# Disk cache directory (default ~/.cache/astromcp)
ASTROMCP_CACHE_DIR=
